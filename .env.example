# Настройки Django
DEBUG=True
SECRET_KEY=django-insecure-library-hub-secret-key-2026

# Настройки контейнера PostgreSQL
POSTGRES_DB=library_hub_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=library_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Строка подключения для django-environ
DATABASE_URL=postgres://library_user:library_pass@127.0.0.1:5432/library_hub_db
